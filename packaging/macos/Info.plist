<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Pocketwire Bridge</string>
  <key>CFBundleDisplayName</key><string>Pocketwire Bridge</string>
  <key>CFBundleIdentifier</key><string>app.pocketwire.bridge</string>
  <key>CFBundleExecutable</key><string>pocketwire</string>
  <key>CFBundleIconFile</key><string>Pocketwire</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <!-- Menu bar only: no Dock icon, no app menu. -->
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <!-- Shown when the Bridge first sends a text through Messages. -->
  <key>NSAppleEventsUsageDescription</key><string>Pocketwire Bridge sends the texts you approve through Messages.</string>
</dict>
</plist>
